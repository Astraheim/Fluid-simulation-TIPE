


    // Calcule les dérivées de la densité et les stocke dans chaque cellule.
    pub fn compute_density_derivatives2(&mut self) {
        let h = DX;
        let inv_2h = 1.0 / (2.0 * h);
        let inv_h2 = 1.0 / (h * h);
        let inv_4h2 = 1.0 / (4.0 * h * h);

        let mut updated_cells = self.cells.clone(); // Clone les cellules pour les modifier séparément

        self.iter_morton().for_each(|(i, j, idx)| {
            let cell = &self.cells[idx];
            if cell.wall {
                return;
            }

            let get_density = |di: isize, dj: isize| {
                self.try_index((i as isize + di) as usize, (j as isize + dj) as usize)
                    .map(|id| self.cells[id].density)
                    .unwrap_or(cell.density)
            };

            let fx = (get_density(1, 0) - get_density(-1, 0)) * inv_2h;
            let fy = (get_density(0, 1) - get_density(0, -1)) * inv_2h;

            let fxx = (get_density(1, 0) - 2.0 * cell.density + get_density(-1, 0)) * inv_h2;
            let fyy = (get_density(0, 1) - 2.0 * cell.density + get_density(0, -1)) * inv_h2;

            let fxy = (get_density(1, 1) - get_density(1, -1) - get_density(-1, 1) + get_density(-1, -1)) * inv_4h2;

            updated_cells[idx].density_x = fx;
            updated_cells[idx].density_y = fy;
            updated_cells[idx].density_xx = fxx;
            updated_cells[idx].density_yy = fyy;
            updated_cells[idx].density_xy = fxy;
        });

        self.cells = updated_cells; // Une fois la modification terminée, on applique les changements
    }


