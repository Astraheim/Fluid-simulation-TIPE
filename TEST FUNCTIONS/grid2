// Fonction pour afficher un aperçu ASCII de la densité
fn print_density_preview(grid: &Grid2) {
    const PREVIEW_HEIGHT: usize = 20;
    const PREVIEW_WIDTH: usize = 70;

    // Caractères pour représenter différentes densités
    let density_chars = " .:-=+*#%@";
    let max_char_idx = density_chars.len() - 1;

    // Échantillonner la grille
    let step_i = grid.width / PREVIEW_WIDTH;
    let step_j = grid.height / PREVIEW_HEIGHT;

    println!("Aperçu de la densité:");
    println!("{}", "-".repeat(PREVIEW_WIDTH + 2));

    for j in (0..grid.height).step_by(step_j) {
        print!("|");
        for i in (0..grid.width).step_by(step_i) {
            let cell = grid.cell_idx(i, j);

            // Afficher les cellules solides avec '#'
            if cell.is_solid() {
                print!("#");
                continue;
            }

            // Normaliser la densité entre 0 et 1, puis mappez-la aux caractères
            let density = (cell.density.back).min(1.0).max(0.0);
            let char_idx = (density * max_char_idx as f32) as usize;
            let density_char = density_chars.chars().nth(char_idx).unwrap_or(' ');

            print!("{}", density_char);
        }
        println!("|");
    }

    println!("{}", "-".repeat(PREVIEW_WIDTH + 2));
}

